# ============================================
# MiniMax (Anthropic 兼容) 配置示例
# 复制本文件为 .env 并填入真实值
# ============================================

# 模型名称
MINIMAX_MODEL_NAME=MiniMaxi-M2.7

# API 地址（Anthropic 兼容协议）
MINIMAX_API_URL=https://api.minimaxi.com/anthropic

# API Key（必填，请到 MiniMax 后台申请，不要提交到 git）
MINIMAX_API_KEY=sk-api-your-real-key-here
